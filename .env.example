# No NEXT_PUBLIC_ prefixes: everything is read on the server.

# Supabase. On Vercel the Supabase integration creates these three for you.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Any long random string.
CRON_SECRET=

# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional
# SITE_URL=https://your-app.vercel.app   # defaults to Vercel's production domain
# ENABLE_GOOGLE_LOGIN=true               # after enabling Google in Supabase
# APP_TIMEZONE=Asia/Kolkata
